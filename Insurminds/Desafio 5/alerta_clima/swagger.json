          "precip": {
            "type": "string",
            "title": "Precip"
          },
          "wind_gusts": {
            "type": "string",
            "title": "Wind Gusts"
          }
        },
        "type": "object",
        "required": [
          "description",
          "weather_code",
          "weather_icon",
          "temp_max",
          "temp_min",
          "sunrise",
          "sunset",
          "precip_prob",
          "precip",
          "wind_gusts"
        ],
        "title": "Current"
      },
      "Forecast": {
        "properties": {
          "description": {
            "type": "string",
            "title": "Description"
          },
          "weather_code": {
            "type": "integer",
            "title": "Weather Code"
          },
          "weather_icon": {
            "type": "string",
            "title": "Weather Icon"
          },
          "temp_max": {
            "type": "string",
