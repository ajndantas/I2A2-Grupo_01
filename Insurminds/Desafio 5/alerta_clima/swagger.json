          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Tips": {
        "properties": {
          "temp": {
            "items": {
              "type": "string"
            },
            "type": "array",
