    +def _validate_password(p):
    +    if not p or len(p.strip()) < 12:
    +        return False, "A senha deve ter pelo menos 12 caracteres."
    +    return True, ""
    +
    +def _password_strength_label(p: str):
    +    if not p:
    +        return 0, "Digite uma senha"
    +    score = 0
    +    if len(p) >= 12: score += 1
    +    if re.search(r"[a-z]", p): score += 1
    +    if re.search(r"[A-Z]", p): score += 1
    +    if re.search(r"[0-9]", p): score += 1
    +    if re.search(r"[^a-zA-Z0-9]", p): score += 1
    +    labels = ["Muito fraca", "Fraca", "Ok", "Boa", "Forte", "Excelente"]
    +    return score, labels[score]
